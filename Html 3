{% extends "base.html" %}
{% block title %}Create Event - EventManager{% endblock %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-5">
                    <h2 class="fw-bold text-dark mb-1">➕ Create New Event</h2>
                    <p class="text-muted">Fill in the details to create your event</p>
                </div>
                
                <form method="POST">
                    {{ form.hidden_tag() }}
                    
                    <div class="mb-4">
                        {{ form.title.label(class="form-label fw-semibold") }}
                        {{ form.title(class="form-control form-control-lg", placeholder="e.g. Tech Conference 2024") }}
                        {% for error in form.title.errors %}
                            <div class="text-danger small mt-1">{{ error }}</div>
                        {% endfor %}
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            {{ form.event_date.label(class="form-label fw-semibold") }}
                            {{ form.event_date(class="form-control form-control-lg") }}
                            {% for error in form.event_date.errors %}
                                <div class="text-danger small mt-1">{{ error }}</div>
                            {% endfor %}
                        </div>
                        <div class="col-md-6 mb-4">
                            {{ form.status.label(class="form-label fw-semibold") }}
                            {{ form.status(class="form-select form-select-lg") }}
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form.description.label(class="form-label fw-semibold") }}
                        {{ form.description(class="form-control", rows=3, placeholder="Event description...") }}
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            {{ form.location.label(class="form-label fw-semibold") }}
                            {{ form.location(class="form-control", placeholder="e.g. Conference Hall A") }}
                        </div>
                        <div class="col-md-6 mb-4">
                            {{ form.organizer.label(class="form-label fw-semibold") }}
                            {{ form.organizer(class="form-control", placeholder="Your name/organization") }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            {{ form.capacity.label(class="form-label fw-semibold") }}
                            {{ form.capacity(class="form-control", placeholder="e.g. 100") }}
                        </div>
                        <div class="col-md-6 mb-4">
                            {{ form.price.label(class="form-label fw-semibold") }}
                            {{ form.price(class="form-control", placeholder="e.g. 25.00") }}
                            <div class="form-text">Leave empty for free events</div>
                        </div>
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-calendar-plus me-2"></i>Create Event
                        </button>
                        <a href="{{ url_for('index') }}" class="btn btn-outline-secondary">
                            ← Back to Events
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
